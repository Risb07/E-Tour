{
  "_comment": [
    "Committed defaults - NO REAL CREDENTIALS IN THIS FILE.",
    "Every value can be overridden by an environment variable using ASP.NET Core's",
    "standard convention, nesting with a double underscore, e.g.",
    "ConnectionStrings__Default, Jwt__Secret, OAuth__Google__ClientSecret.",
    "Docker Compose supplies all of them from the project's .env file, exactly as it",
    "does for the Java backend. For local 'dotnet run', export them or put them in",
    "appsettings.Development.json. See ../../BACKEND_SWITCHING.md."
  ],

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=etour;User=root;Password=;AllowPublicKeyRetrieval=True;SslMode=None"
  },

  "Jwt": {
    "Secret": "",
    "ExpirationMs": 86400000
  },

  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost:3000"
  },

  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/login/oauth2/code/google"
    },
    "SuccessRedirectUrl": "http://localhost:5173/oauth/callback",
    "FailureRedirectUrl": "http://localhost:5173/login",
    "Compat": {
      "SuccessRedirectUrl": "http://localhost:5173/oauth2/callback",
      "FailureRedirectUrl": "http://localhost:5173/login"
    }
  },

  "Upload": {
    "Directory": "uploads"
  },

  "Mail": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "noreply@etour.example.com"
  },

  "Notification": {
    "BaseUrl": "http://notification-service:8085",
    "Enabled": true
  },

  "Invoice": {
    "GstRate": 0.05
  },

  "Payment": {
    "Provider": "simulated"
  },

  "Seed": {
    "Enabled": true
  },

  "JavaMicroservice": {
    "BaseUrl": "http://localhost:8080"
  },

  "Ai": {
    "Provider": "openai",
    "ApiKey": "",
    "Model": "gpt-4o-mini"
  }
}
