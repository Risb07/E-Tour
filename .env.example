# =============================================================================
# eTour - Docker Compose configuration
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#   docker compose up --build
#
# Every value here has a working default in docker-compose.yml, so the stack
# starts even with no .env at all. Set the marked ones before exposing this to
# anyone else.
# =============================================================================

# --- LOCAL DEVELOPMENT ONLY --------------------------------------------------
# Uncomment BOTH lines to run on a laptop. Leave them commented out on the
# server.
#
# Why: etour-frontend/nginx.conf terminates TLS for etourvita.shop using
# Let's Encrypt certificates that only exist on the EC2 host. Without them nginx
# exits at startup with "cannot load certificate" and restarts forever.
#
# COMPOSE_FILE makes every `docker compose ...` command in this directory pick
# up the local override automatically, so you never have to remember the two
# -f flags. Windows uses ';' as the separator; on macOS/Linux use ':'.
#
#COMPOSE_FILE=docker-compose.yml;docker-compose.local.yml
#
# An empty folder that exists in the repo. The base compose file mounts it at
# /etc/letsencrypt; the local nginx config never reads a certificate, so it is
# simply an unused mount. Without this, Docker is asked to bind /etc/letsencrypt
# which does not exist on Windows.
#CERTS_DIR=./docker/certs

# --- Public URL & port -------------------------------------------------------
# The origin the BROWSER uses. It ends up in three places at once:
#   - baked into the React bundle as VITE_API_BASE_URL (build time)
#   - the Google OAuth redirect URI and the post-login redirect
#   - the backend's allowed CORS origin
#
# Changing it requires a frontend rebuild, because Vite inlines it:
#   docker compose up --build frontend
#
# Include the port unless it is 80: e.g. APP_PORT=8081 -> http://localhost:8081
APP_PUBLIC_URL=http://localhost
APP_PORT=80

# --- MySQL -------------------------------------------------------------------
# CHANGE THESE before any shared or public deployment.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=etour
MYSQL_USER=etour
MYSQL_PASSWORD=etourpassword

# Dump under ./db/ imported on first start only (empty data volume).
# To re-seed after changing it:  docker compose down -v && docker compose up --build
DB_SEED_FILE=etour_20260804_165623.sql

# 'update' reconciles the schema with the entities. 'validate' once settled.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- JWT ---------------------------------------------------------------------
# REQUIRED in production. Left empty, the backend generates a random key at
# startup: it runs, but every restart logs all users out.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Google OAuth 2.0 sign-in (optional) -------------------------------------
# Blank = the feature stays off and the button never renders. See
# GOOGLE_OAUTH_LOGIN.md.
#
# In the Google Cloud Console, the authorised redirect URI must be
# APP_PUBLIC_URL + /login/oauth2/code/google — for the default that is:
#     http://localhost/login/oauth2/code/google
# Note: NO :8080. Under Docker the browser reaches the backend through nginx.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mail (optional) ---------------------------------------------------------
# Unset, receipt emails are skipped and logged; payments still succeed and the
# receipt stays downloadable from the dashboard.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@etour.example.com

# --- Business config ---------------------------------------------------------
INVOICE_GST_RATE=0.05
PAYMENT_PROVIDER=simulated

# --- .NET backend only -------------------------------------------------------
# Everything above is shared by BOTH backends. These apply only when running
# with `docker compose --profile dotnet up`.
#
# The .NET demo-data seeder is idempotent - it inserts only what is missing, so
# it is safe against the restored dump. Set to false to leave the database
# exactly as the dump left it.
DOTNET_SEED_ENABLED=true

# Production or Development. Development additionally exposes Swagger at
# /swagger, which is worth enabling if you want to show the API surface.
DOTNET_ENVIRONMENT=Production

# Optional: OpenAI-compatible key for the .NET backend's admin-only tour
# description assistant. Blank means that one endpoint returns 503 and
# everything else is unaffected.
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Notification microservice -----------------------------------------------
# Runs alongside BOTH backends (it has no compose profile) and is reached at
# /svc/notifications through nginx. It owns its own database and user on the
# SAME MySQL server as eTour - the notify user is granted rights on this schema
# only, so these credentials are unrelated to the eTour ones above and can be
# changed freely without touching either backend.
#
# The database and user are created by docker/mysql/20-grants.sh, which runs
# only when the db volume is first initialised. Changing NOTIFY_DB_PASSWORD on
# an existing installation therefore needs one manual GRANT - the exact command
# is in notification-service/README.md, under "Its own database".
NOTIFY_DB_NAME=etour_notify
NOTIFY_DB_USERNAME=notify
NOTIFY_DB_PASSWORD=notifypassword

# Total delivery attempts per message, INCLUDING the first. 2 = the initial
# send plus exactly one retry, after which the message is dead-lettered and
# waits for an admin to re-queue it from the admin screen. Set to 1 to disable
# retrying entirely.
NOTIFY_MAX_ATTEMPTS=2
NOTIFY_RETRY_DELAY_SECONDS=30

# Blank auto-detects: "smtp" when MAIL_USERNAME is set, otherwise "simulated",
# which logs instead of sending. Force one with "smtp" or "simulated".
#
# In simulated mode any recipient starting with "fail" (e.g. fail@example.com)
# always fails - that is how you demonstrate the retry and dead-letter path
# without a real mail server.
NOTIFY_TRANSPORT=

# The service verifies eTour JWTs with JWT_SECRET above - the same secret both
# backends sign with - so no extra credential is needed for sign-in.

# --- Misc --------------------------------------------------------------------
TZ=UTC
