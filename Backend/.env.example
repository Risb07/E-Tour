# eTour backend — OPTIONAL environment overrides.
#
# You do NOT need this file to run locally. application.properties already has
# working defaults for a standard local MySQL install. Use these only when a
# default doesn't match your setup, or when deploying.
#
# Spring Boot does not read .env files natively. Use one of:
#   - your IDE's "Environment variables" field in the run configuration
#   - PowerShell:  $env:DB_PASSWORD="secret"
#   - macOS/Linux: export DB_PASSWORD=secret
#   - a real secret manager in production

# --- Database -------------------------------------------------------------
# Defaults: root / (empty password) / localhost:3306/etour
DB_URL=jdbc:mysql://localhost:3306/etour?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --- JWT ------------------------------------------------------------------
# If unset, a random key is generated per startup: the app runs, but everyone
# is logged out on every restart. REQUIRED in production.
# Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SMTP (optional; receipts are skipped and logged if unset) ------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@etour.example.com

# --- Business config ------------------------------------------------------
INVOICE_GST_RATE=0.05
PAYMENT_PROVIDER=simulated

# --- Dev conveniences -----------------------------------------------------
JPA_SHOW_SQL=false
# 'update' (default) lets Hibernate maintain the schema. Use 'validate' in prod.
JPA_DDL_AUTO=update
